---
/**
 * Full-screen image viewer. Wrap content in an element with x-data="lightbox" and any
 * <img> inside `.guide-prose` or element with `data-lightbox` becomes clickable; this component
 * renders the overlay (must live inside the same x-data scope).
 */
import Icon from './Icon.astro';
---

<div
  x-show="open"
  x-cloak
  x-transition.opacity.duration.150ms
  class="fixed inset-0 z-50 flex flex-col bg-zinc-950/95 backdrop-blur-sm cursor-zoom-out"
  role="dialog"
  aria-modal="true"
  aria-label="Image viewer"
  @keydown.escape.window="close()"
  @keydown.arrow-left.window="open && prev()"
  @keydown.arrow-right.window="open && next()"
  @click.self="close()"
>
  <div class="flex items-center justify-between gap-4 px-4 py-3 text-sm text-zinc-300">
    <div class="min-w-0">
      <p class="truncate font-medium text-zinc-100" x-text="current?.title"></p>
      <p class="truncate text-xs text-zinc-500" x-text="current?.caption"></p>
    </div>
    <div class="flex shrink-0 items-center gap-2">
      <span class="text-xs text-zinc-500" x-show="images.length > 1"><span x-text="index + 1"></span> / <span x-text="images.length"></span></span>
      <a :href="current?.src" target="_blank" rel="noopener" class="btn btn-sm" title="Open image in a new tab">
        <Icon name="external" class="size-3.5" /> Full size
      </a>
      <button type="button" class="btn btn-sm" @click="close()" aria-label="Close">
        <Icon name="x" class="size-4" />
      </button>
    </div>
  </div>

  <div class="relative flex min-h-0 flex-1 items-center justify-center px-4 pb-4" @click.self="close()">
    <button type="button" x-show="images.length > 1" class="btn absolute left-4 top-1/2 -translate-y-1/2" @click="prev()" aria-label="Previous image">
      <Icon name="arrow-left" class="size-4" />
    </button>
    <img :src="current?.src" :alt="current?.title" class="max-h-full max-w-full cursor-default rounded-lg object-contain shadow-2xl" style="image-rendering: auto" />
    <button type="button" x-show="images.length > 1" class="btn absolute right-4 top-1/2 -translate-y-1/2" @click="next()" aria-label="Next image">
      <Icon name="arrow-right" class="size-4" />
    </button>
  </div>
</div>

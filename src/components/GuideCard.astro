---
import Badge from './Badge.astro';
import Icon from './Icon.astro';
import { formatDate, type Guide, type Game } from '../lib/data';
import { guideTypeById } from '../lib/constants.js';

interface Props {
  guide: Guide;
  game?: Game;
}

const { guide, game } = Astro.props;
const d = guide.data;
const type = guideTypeById(d.type);
const search = [d.title, d.summary, game?.data.title, type.label, ...d.tags].filter(Boolean).join(' ');
---

<article
  data-item
  data-search={search}
  data-type={d.type}
  data-kind="guide"
  data-updated={d.updatedAt}
  data-sort={d.title.toLowerCase()}
  class="card card-hover relative flex flex-col gap-2 p-4"
>
  <div class="flex items-center gap-2">
    <Badge color={type.color} label={type.label} />
    {game && <span class="truncate text-xs text-zinc-500">{game.data.title}</span>}
  </div>
  <h3 class="text-base font-semibold leading-snug text-zinc-100">
    <a href={`/guides/${guide.id}`} class="after:absolute after:inset-0 hover:text-amber-300">{d.title}</a>
  </h3>
  {d.summary && <p class="line-clamp-2 text-sm text-zinc-400">{d.summary}</p>}
  <p class="mt-auto flex items-center gap-1 pt-1 text-xs text-zinc-500">
    <Icon name="calendar" class="size-3.5" /> Updated {formatDate(d.updatedAt)}
  </p>
</article>

---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Not found">
  <div class="flex flex-col items-center py-20 text-center">
    <p class="eyebrow mb-3">Error 404</p>
    <h1 class="h-display text-6xl">Game Over</h1>
    <p class="mt-3 max-w-md text-zinc-400">That page doesn't exist. Maybe it was renamed in the admin, or it never spawned in the first place.</p>
    <div class="mt-6 flex gap-2">
      <a href="/" class="btn btn-accent"><Icon name="home" class="size-4" /> Continue</a>
      <a href="/games" class="btn"><Icon name="grid" class="size-4" /> Library</a>
    </div>
  </div>
</Base>

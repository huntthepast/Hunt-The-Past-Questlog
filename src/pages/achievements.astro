---
import Base from '../layouts/Base.astro';
import FilterBar from '../components/FilterBar.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatTile from '../components/StatTile.astro';
import EmptyState from '../components/EmptyState.astro';
import Pagination from '../components/Pagination.astro';
import ListCounter from '../components/ListCounter.astro';
import ProgressBar from '../components/ProgressBar.astro';
import GameRow from '../components/GameRow.astro';
import Badge from '../components/Badge.astro';
import Icon from '../components/Icon.astro';
import { raProfile, raSynced, allGames, raGamePaths, gameIcons, platformOf, raTrackedSeconds, shelfAwards, awardKind, shelf as shelfOverrides, formatDate, formatDateTime, formatNumber } from '../lib/data';
import { RA_SITE, raImage } from '../lib/constants.js';
import { bar, text } from '../lib/ui';

/** Rows in the two "recent" lists. The same number in both keeps the columns level. */
const RECENT_LIMIT = 10;

const synced = raSynced();
const games = await allGames();
const trackedSeconds = await raTrackedSeconds();
// RA game id -> page on this site (subsets open their parent game on the subset tab).
const raPath = await raGamePaths(games);
const icons = await gameIcons(games);
// RA game id -> the library entry, for the platform and status of games I actually own.
const gameByRaId = new Map(games.filter((g) => g.data.raGameId).map((g) => [g.data.raGameId!, g]));

/*
 * These tiles count RetroAchievements awards, while the library filters on my own status, so the two
 * are related but never identical - RA can call something completed that I filed as mastered. A tile
 * only links when the library actually holds games with that status, so the link cannot land on an
 * empty shelf or, worse, silently show everything.
 */
const shelfLink = (status: string) => (games.some((g) => g.data.ownership === 'owned' && g.data.status === status) ? `/games?status=${status}` : undefined);

const completion = [...raProfile.completion].sort((a, b) => (b.mostRecentAwardedDate ?? '').localeCompare(a.mostRecentAwardedDate ?? ''));
const consoles = [...new Set(completion.map((c) => c.consoleName))].sort();

/** Award levels RetroAchievements hands out per game, plus 'none' for games with unlocks but no award. */
const AWARD_KINDS = [
  { id: 'mastered', label: 'Mastered', color: 'amber', description: 'Every achievement, in hardcore mode' },
  { id: 'completed', label: 'Completed', color: 'violet', description: 'Every achievement, in softcore mode' },
  { id: 'beaten-hardcore', label: 'Beaten', color: 'emerald', description: 'Beaten in hardcore mode' },
  { id: 'beaten-softcore', label: 'Beaten (softcore)', color: 'teal', description: 'Beaten in softcore mode' },
  { id: 'none', label: 'In progress', color: 'zinc', description: 'Some unlocks, no award yet' },
];
const awardOf = (c: { highestAwardKind: string | null }) => (c.highestAwardKind && AWARD_KINDS.some((k) => k.id === c.highestAwardKind) ? c.highestAwardKind : 'none');
const awardCounts = AWARD_KINDS.map((kind) => ({ kind, count: completion.filter((c) => awardOf(c) === kind.id).length }));

const AWARD_PRESETS = [
  { label: 'All', kinds: AWARD_KINDS.map((k) => k.id) },
  { label: 'Mastered', kinds: ['mastered'] },
  { label: 'Beaten or better', kinds: ['mastered', 'completed', 'beaten-hardcore', 'beaten-softcore'] },
  { label: 'In progress', kinds: ['none'] },
];

const PAGE_SIZES = [25, 50, 100, 0];

/* Trophy shelf: one badge per game, RA's profile order unless rearranged in the admin. */
const shelf = shelfAwards();
const shelfManual = shelfOverrides.order.length > 0 || shelfOverrides.hidden.length > 0;
const shelfCounts = AWARD_KINDS.filter((k) => k.id !== 'none').map((kind) => ({ kind, count: shelf.filter((a) => awardKind(a) === kind.id).length }));
const SHELF_FRAME: Record<string, string> = {
  mastered: 'border-amber-400/80 shadow-glow',
  completed: 'border-zinc-300/70',
  'beaten-hardcore': 'border-emerald-500/60',
  'beaten-softcore': 'border-teal-500/50',
  other: 'border-zinc-700',
};
const shelfFilterConfig = {
  multi: { kind: shelfCounts.map((c) => c.kind.id) },
  storageKey: 'questlog:shelf',
};

const filterConfig = {
  facets: ['console'],
  multi: { award: AWARD_KINDS.map((k) => k.id) },
  flags: ['library'],
  defaultSort: 'recent',
  pageSize: 50,
  pageSizes: PAGE_SIZES,
  storageKey: 'questlog:achievements',
  sorts: {
    recent: { attr: 'recent', dir: 'desc' },
    title: { attr: 'sort' },
    titleDesc: { attr: 'sort', dir: 'desc' },
    pct: { attr: 'pct', dir: 'desc', numeric: true },
    unlocked: { attr: 'unlocked', dir: 'desc', numeric: true },
    console: { attr: 'console' },
  },
};
---

<Base title="Achievements" description="RetroAchievements profile, recent unlocks, masteries and per-game completion.">
  <SectionHeading level="h1" eyebrow="RetroAchievements" title="Achievements">
    {
      synced && (
        <p class="mt-2 text-sm text-zinc-400">
          Snapshot from {formatDateTime(raProfile.syncedAt)}. Live data lives on
          <a href={raProfile.profileUrl} target="_blank" rel="noopener" class="text-amber-400 hover:underline">retroachievements.org</a>.
        </p>
      )
    }
  </SectionHeading>

  {
    !synced ? (
      <EmptyState title="Not synced yet" icon="trophy">
        <p>
          This page is filled from a snapshot of your RetroAchievements profile. Put your username and web API key in
          <code class="rounded bg-zinc-800 px-1">.env</code>, run <code class="rounded bg-zinc-800 px-1">npm run admin</code>, open the
          RetroAchievements tab, click <strong>Sync now</strong>, then publish.
        </p>
      </EmptyState>
    ) : (
      <>
        {/* Avatar and name stay together from sm up; the three big numbers drop below them until
            there is room for all three groups on one line at lg. */}
        <section class="card mb-8 flex flex-col gap-5 p-5 lg:flex-row lg:items-center">
          <div class="flex min-w-0 flex-1 flex-col gap-5 sm:flex-row sm:items-center">
          <img src={raProfile.avatar} alt={`${raProfile.user}'s avatar`} width="96" height="96" class="size-24 shrink-0 self-center rounded-xl bg-zinc-800 object-cover sm:self-auto" />
          <div class="min-w-0 flex-1 text-center sm:text-left">
            {/* Stacked on a phone so the rank always gets its own line under the name, rather than
                sitting beside it on a wide handset and wrapping on a narrow one. */}
            <div class="flex flex-col items-center gap-2 sm:flex-row sm:flex-wrap sm:items-center sm:justify-start">
              <a href={raProfile.profileUrl} target="_blank" rel="noopener" class="font-display text-3xl text-zinc-50 hover:text-amber-300">
                {raProfile.user}
              </a>
              {raProfile.rank && (
                <Badge color="amber" label={`Rank #${formatNumber(raProfile.rank)}${raProfile.totalRanked ? ` of ${formatNumber(raProfile.totalRanked)}` : ''}`} />
              )}
            </div>
            {raProfile.motto && <p class="mt-1 text-sm italic text-zinc-400">"{raProfile.motto}"</p>}
            <p class="mt-1 text-xs text-zinc-500">Member since {formatDate(raProfile.memberSince)}</p>
            {raProfile.richPresence && (
              <p class="mt-2 inline-flex items-center gap-1.5 rounded-lg bg-zinc-800/80 px-2.5 py-1 text-left text-xs text-zinc-300">
                <Icon name="gamepad" class="size-3.5 text-amber-400" /> {raProfile.richPresence}
              </p>
            )}
          </div>
          </div>
          <dl class="grid shrink-0 grid-cols-3 gap-4 text-center lg:text-right">
            <div>
              <dt class="text-[11px] uppercase tracking-wider text-zinc-500">Points</dt>
              <dd class="text-2xl font-bold tracking-tight text-amber-300 tabular-nums">{formatNumber(raProfile.points)}</dd>
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-wider text-zinc-500">RetroPoints</dt>
              <dd class="text-2xl font-bold tracking-tight text-zinc-100 tabular-nums">{formatNumber(raProfile.truePoints)}</dd>
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-wider text-zinc-500">Softcore</dt>
              <dd class="text-2xl font-bold tracking-tight text-zinc-400 tabular-nums">{formatNumber(raProfile.softcorePoints)}</dd>
            </div>
          </dl>
        </section>

        <section class="mb-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
          <StatTile label="Games played" value={formatNumber(raProfile.stats.gamesPlayed)} icon="gamepad" color="sky" href="/games" />
          <StatTile label="Achievements" value={formatNumber(raProfile.stats.achievementsEarned)} icon="check-circle" color="emerald" />
          <StatTile label="Mastered" value={formatNumber(raProfile.stats.masteries)} icon="trophy" color="amber" href={shelfLink('mastered')} />
          <StatTile label="Completed" value={formatNumber(raProfile.stats.completions)} icon="sparkles" color="violet" href={shelfLink('completed')} />
          <StatTile label="Beaten" value={formatNumber(raProfile.stats.beatenHardcore + raProfile.stats.beatenSoftcore)} hint={`${raProfile.stats.beatenHardcore} hardcore`} icon="flag" color="teal" href={shelfLink('beaten')} />
          <StatTile label="Tracked playtime" value={trackedSeconds > 0 ? `${formatNumber(Math.round(trackedSeconds / 3600))}h` : '--'} hint="across linked games" icon="clock" color="rose" />
        </section>

        <div class="mb-10 grid grid-cols-1 gap-10 lg:grid-cols-2">
          <section>
            <SectionHeading eyebrow="Last sessions" title="Recently Played" />
            {raProfile.recentlyPlayed.length ? (
              <ul class="card divide-y divide-zinc-800">
                {raProfile.recentlyPlayed.slice(0, RECENT_LIMIT).map((g) => {
                  // A game in the library shows its own platform and status; anything else keeps RA's console name.
                  const owned = gameByRaId.get(g.gameId);
                  return (
                    <GameRow
                      href={raPath.get(g.gameId) ?? `${RA_SITE}/game/${g.gameId}`}
                      external={!raPath.has(g.gameId)}
                      title={g.title}
                      icon={owned ? icons.get(owned.id) : raImage(g.imageIcon)}
                      platform={owned ? platformOf(owned.data.platform).short : g.consoleName}
                      date={formatDateTime(g.lastPlayed)}
                      status={owned?.data.status}
                      progress={{
                        done: g.numAchieved,
                        total: g.numPossible,
                        pct: g.numPossible ? Math.round((g.numAchieved / g.numPossible) * 100) : 0,
                      }}
                    />
                  );
                })}
              </ul>
            ) : (
              <EmptyState title="No recent sessions" icon="gamepad" />
            )}
          </section>

          <section>
            <SectionHeading eyebrow="Fresh" title="Recent Unlocks" />
            {raProfile.recentAchievements.length ? (
              <ul class="card divide-y divide-zinc-800">
                {raProfile.recentAchievements.slice(0, RECENT_LIMIT).map((a) => (
                  /* The row height lives on the <li>, the same element divide-y borders, so border-box
                     absorbs the separator. On the anchor instead, the border would stack on top of it
                     and this column would sit a fraction of a pixel below the other one, every row. */
                  <li class="flex min-h-24">
                    <a href={`${RA_SITE}/achievement/${a.id}`} target="_blank" rel="noopener" class="flex min-w-0 flex-1 items-center gap-3 p-3 transition hover:bg-zinc-800/50">
                      <img src={raImage(a.badge)} alt="" width="48" height="48" loading="lazy" class="size-12 shrink-0 rounded bg-zinc-800" />
                      <span class="min-w-0 flex-1">
                        <span class="flex items-center gap-1.5 truncate font-medium text-zinc-100">
                          {a.title}
                          {a.hardcore && <Icon name="bolt" solid class="size-3.5 shrink-0 text-amber-400" title="Hardcore" />}
                        </span>
                        <span class="block truncate text-xs text-zinc-400">{a.description}</span>
                        <span class="block truncate text-xs text-zinc-500">
                          {a.gameTitle} &middot; {formatDateTime(a.date)}
                        </span>
                      </span>
                      <span class="shrink-0 text-xs font-semibold text-amber-300 tabular-nums">{a.points} pts</span>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <EmptyState title="No recent unlocks" icon="trophy" />
            )}
          </section>
        </div>

        <section class="mb-10 scroll-mt-24" x-data={`listFilter(${JSON.stringify(filterConfig)})`}>
          <SectionHeading eyebrow="Per game" title="Completion Progress">
            <p class="mt-2 text-sm text-zinc-400">{completion.length} games with at least one unlock.</p>
          </SectionHeading>

          {/* Award breakdown: the bar is informational, the chips toggle which award levels are listed. */}
          <div class="card mb-4 p-4 sm:p-5">
            <div class="mb-4 flex h-3 w-full overflow-hidden rounded-full bg-zinc-800" role="img" aria-label="Award breakdown">
              {awardCounts
                .filter((c) => c.count > 0)
                .map((c) => (
                  <div class={bar(c.kind.color)} style={`width:${(c.count / Math.max(completion.length, 1)) * 100}%`} title={`${c.kind.label}: ${c.count}`}></div>
                ))}
            </div>

            <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Award levels to show">
              {awardCounts.map((c) => (
                <button
                  type="button"
                  class="chip chip-btn ring-zinc-700 bg-zinc-900 text-zinc-300 px-3 py-1 text-sm font-medium transition disabled:opacity-30 disabled:hover:brightness-100"
                  :class={`{ 'opacity-40 grayscale': !has('award', ${JSON.stringify(c.kind.id)}) }`}
                  :aria-pressed={`has('award', ${JSON.stringify(c.kind.id)}) ? 'true' : 'false'`}
                  @click={`toggle('award', ${JSON.stringify(c.kind.id)})`}
                  title={c.kind.description}
                  disabled={c.count === 0}
                >
                  <span class:list={['size-2.5 rounded-full', bar(c.kind.color)]}></span>
                  {c.kind.label}
                  <span class:list={['ml-0.5 tabular-nums', text(c.kind.color)]}>{c.count}</span>
                </button>
              ))}
            </div>

            <div class="mt-3 flex flex-wrap items-center gap-x-1 gap-y-1 text-xs text-zinc-500">
              <span class="mr-1">Show:</span>
              {AWARD_PRESETS.map((preset) => (
                <button
                  type="button"
                  class="rounded-md px-2 py-1 transition hover:bg-zinc-800 hover:text-zinc-100"
                  :class={`{ 'bg-zinc-800 text-amber-300': is('award', ${JSON.stringify(preset.kinds)}) }`}
                  @click={`set('award', ${JSON.stringify(preset.kinds)})`}
                >
                  {preset.label}
                </button>
              ))}
              <button type="button" class="rounded-md px-2 py-1 transition hover:bg-zinc-800 hover:text-zinc-100" @click="set('award', [])">None</button>
            </div>
          </div>

          <FilterBar label="Search" placeholder="Search games or consoles...">
              
              <select x-model="facet.console" class="input sm:w-52" aria-label="Console">
                <option value="">All consoles</option>
                {consoles.map((c) => (
                  <option value={c}>{c}</option>
                ))}
              </select>
              <select x-model="sort" class="input sm:w-44" aria-label="Sort by">
                <option value="recent">Last unlock</option>
                <option value="pct">Completion %</option>
                <option value="unlocked">Unlocked count</option>
                <option value="title">A-Z</option>
                <option value="titleDesc">Z-A</option>
                <option value="console">Console</option>
              </select>
              <select x-model.number="pageSize" class="input sm:w-32" aria-label="Games per page">
                {PAGE_SIZES.map((size) => (
                  <option value={size}>{size === 0 ? 'Show all' : `${size} / page`}</option>
                ))}
              </select>
              <button
                type="button"
                role="switch"
                :aria-checked="flag.library ? 'true' : 'false'"
                @click="flag.library = !flag.library"
                class="btn select-none"
                :class="flag.library ? 'border-amber-400/60 bg-amber-400/10 text-amber-300 hover:border-amber-300' : ''"
                title="Only games that are in the library"
              >
                <Icon name="gamepad" class="size-4" />
                In library
              </button>
            <ListCounter slot="footer" total={completion.length} pageSize={50} noun="games" />
          </FilterBar>

          <ul class="card divide-y divide-zinc-800">
            {completion.map((c) => {
              const local = raPath.get(c.gameId);
              const pct = c.maxPossible ? Math.round((c.numAwarded / c.maxPossible) * 100) : 0;
              const kind = AWARD_KINDS.find((k) => k.id === awardOf(c));
              return (
                <li
                  data-item
                  data-search={`${c.title} ${c.consoleName}`}
                  data-sort={c.title.toLowerCase().replace(/^(the|a|an)\s+/, '')}
                  data-console={c.consoleName}
                  data-award={awardOf(c)}
                  data-library={local ? '1' : '0'}
                  data-recent={c.mostRecentAwardedDate ?? ''}
                  data-pct={pct}
                  data-unlocked={c.numAwarded}
                >
                  {/* The whole row is the link, like the lists above it: the title alone was a small target. */}
                  <a
                    href={local ?? `${RA_SITE}/game/${c.gameId}`}
                    target={local ? undefined : '_blank'}
                    rel={local ? undefined : 'noopener'}
                    class="flex items-center gap-3 p-3 transition hover:bg-zinc-800/50"
                  >
                    <img src={raImage(c.imageIcon)} alt="" width="40" height="40" loading="lazy" class="size-10 shrink-0 rounded bg-zinc-800" />
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2">
                        <span class="truncate font-medium text-zinc-100">{c.title}</span>
                        {kind && kind.id !== 'none' && <Badge color={kind.color} label={kind.label} class="hidden sm:inline-flex" />}
                        {local && <Icon name="gamepad" class="size-3.5 shrink-0 text-zinc-500" title="In the library" />}
                      </div>
                      <p class="text-xs text-zinc-500">
                        {c.consoleName}
                        {c.mostRecentAwardedDate && <span> &middot; last unlock {formatDate(c.mostRecentAwardedDate)}</span>}
                      </p>
                    </div>
                    <div class="w-28 shrink-0 sm:w-40">
                      <ProgressBar value={pct} color={c.highestAwardKind === 'mastered' ? 'amber' : pct === 100 ? 'violet' : 'emerald'} size="sm" label="Achievements" />
                      <p class="mt-1 text-right text-[11px] tabular-nums text-zinc-400">
                        {c.numAwarded}/{c.maxPossible} &middot; {pct}%
                      </p>
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
          <div x-show="visible === 0" x-cloak class="mt-4">
            <EmptyState title="No games match" icon="filter">
              Turn an award level back on above, or <button type="button" class="text-amber-400 hover:underline" @click="reset()">reset the filters</button>.
            </EmptyState>
          </div>
          <Pagination class="mt-6" />
        </section>

        {shelf.length > 0 && (
          <section class="mb-10" x-data={`listFilter(${JSON.stringify(shelfFilterConfig)})`}>
            <SectionHeading eyebrow="Trophy shelf" title="Game Awards">
              <p class="mt-2 text-sm text-zinc-400">
                {shelfCounts.map((c) => `${c.count} ${c.kind.label.toLowerCase()}`).filter((_, i) => shelfCounts[i]!.count > 0).join(', ')}.
                {shelfManual ? 'Arranged by hand in the admin.' : 'Same order as the RetroAchievements profile.'}
              </p>
            </SectionHeading>

            <div class="mb-4 flex flex-wrap items-center gap-2" role="group" aria-label="Award levels to show">
              {shelfCounts.map((c) => (
                <button
                  type="button"
                  class="chip chip-btn ring-zinc-700 bg-zinc-900 text-zinc-300 px-3 py-1 text-sm font-medium transition disabled:opacity-30 disabled:hover:brightness-100"
                  :class={`{ 'opacity-40 grayscale': !has('kind', ${JSON.stringify(c.kind.id)}) }`}
                  :aria-pressed={`has('kind', ${JSON.stringify(c.kind.id)}) ? 'true' : 'false'`}
                  @click={`toggle('kind', ${JSON.stringify(c.kind.id)})`}
                  title={c.kind.description}
                  disabled={c.count === 0}
                >
                  <span class:list={['size-2.5 rounded-full', bar(c.kind.color)]}></span>
                  {c.kind.label}
                  <span class:list={['ml-0.5 tabular-nums', text(c.kind.color)]}>{c.count}</span>
                </button>
              ))}
              <span class="ml-auto text-xs text-zinc-500" x-cloak x-show="active">
                <span x-text="visible"></span> of {shelf.length}
                <button type="button" class="ml-2 text-amber-400 hover:underline" @click="reset()">Reset</button>
              </span>
            </div>

            <ul class="grid grid-cols-4 gap-2 sm:grid-cols-6 md:grid-cols-8 lg:grid-cols-10">
              {shelf.map((a) => {
                const local = a.gameId ? raPath.get(a.gameId) : undefined;
                const kind = awardKind(a);
                const info = AWARD_KINDS.find((k) => k.id === kind);
                return (
                  <li data-item data-kind={kind}>
                    <a
                      href={local ?? `${RA_SITE}/game/${a.gameId}`}
                      target={local ? undefined : '_blank'}
                      rel={local ? undefined : 'noopener'}
                      class:list={['block overflow-hidden rounded-lg border-2 transition hover:scale-105', SHELF_FRAME[kind]]}
                      title={`${a.title} (${a.consoleName}) - ${info?.label ?? kind} ${formatDate(a.awardedAt)}`}
                    >
                      <img src={raImage(a.imageIcon)} alt={a.title} loading="lazy" class="aspect-square w-full bg-zinc-800 object-cover" />
                    </a>
                  </li>
                );
              })}
            </ul>
            <div x-show="visible === 0" x-cloak class="mt-4">
              <EmptyState title="Nothing to show" icon="trophy">
                Turn an award level back on above.
              </EmptyState>
            </div>
          </section>
        )}
      </>
    )
  }
</Base>

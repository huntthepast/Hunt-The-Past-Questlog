---
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import { site } from '../lib/data';

const NAV: { href: string; label: string; icon: IconName }[] = [
  { href: '/games', label: 'Library', icon: 'grid' },
  { href: '/progress', label: 'Progress', icon: 'chart' },
  { href: '/achievements', label: 'Achievements', icon: 'trophy' },
  { href: '/guides', label: 'Guides', icon: 'book' },
  { href: '/wishlist', label: 'Wishlist', icon: 'bookmark' },
  { href: '/favorites', label: 'Favorites', icon: 'heart' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href + '/'));
---

<header class="sticky top-0 z-40 border-b border-zinc-800/80 bg-zinc-950/80 backdrop-blur" x-data="navDrawer" @keydown.escape.window="close()">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href="/" class="group flex items-center gap-2.5" aria-label={`${site.title} home`}>
      <span class="grid size-9 place-items-center rounded-lg bg-amber-400 text-zinc-950 shadow-glow transition group-hover:bg-amber-300">
        <Icon name="gamepad" class="size-5" />
      </span>
      <span class="font-display text-2xl leading-none tracking-wide text-zinc-50">{site.title}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium transition',
              isActive(item.href) ? 'bg-zinc-800/80 text-amber-300' : 'text-zinc-400 hover:bg-zinc-900 hover:text-zinc-100',
            ]}
          >
            <Icon name={item.icon} class="size-4" />
            {item.label}
          </a>
        ))
      }
    </nav>

    <button type="button" class="btn md:hidden" @click="toggle()" :aria-expanded="open" aria-controls="mobile-nav" aria-label="Open navigation">
      <Icon name="menu" class="size-5" />
    </button>
  </div>

  <!-- Phone menu: the same slide-in panel the guide/tracker sidebars use. Teleported to <body> because the
       header's backdrop-blur would otherwise become the containing block of these fixed elements. -->
  <template x-teleport="body">
    <div x-show="open" x-cloak x-transition.opacity.duration.150ms class="fixed inset-0 z-40 bg-black/60 backdrop-blur-sm md:hidden" @click="close()" aria-hidden="true"></div>
  </template>
  <template x-teleport="body">
    <nav
      id="mobile-nav"
      x-show="open"
      x-cloak
      x-transition:enter="transition duration-200 ease-out"
      x-transition:enter-start="translate-x-full"
      x-transition:enter-end="translate-x-0"
      x-transition:leave="transition duration-150 ease-in"
      x-transition:leave-start="translate-x-0"
      x-transition:leave-end="translate-x-full"
      class="fixed inset-y-0 right-0 z-50 flex w-[88vw] max-w-sm flex-col border-l border-zinc-800 bg-zinc-950 shadow-2xl md:hidden"
      aria-label="Primary mobile"
      @click="if ($event.target.closest('a')) close()"
    >
      <div class="flex items-center justify-between border-b border-zinc-800 px-4 py-3">
        <p class="font-display text-xl text-zinc-100">Menu</p>
        <button type="button" class="btn btn-sm" @click="close()" aria-label="Close navigation">
          <Icon name="x" class="size-4" />
        </button>
      </div>
      <div class="grid gap-1 overflow-y-auto p-3">
        <a href="/" aria-current={path === '/' ? 'page' : undefined} class:list={['flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium', path === '/' ? 'bg-zinc-800/80 text-amber-300' : 'text-zinc-300 hover:bg-zinc-900 hover:text-zinc-100']}>
          <Icon name="home" class="size-4 text-zinc-500" />
          Home
        </a>
        {
          NAV.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium',
                isActive(item.href) ? 'bg-zinc-800/80 text-amber-300' : 'text-zinc-300 hover:bg-zinc-900 hover:text-zinc-100',
              ]}
            >
              <Icon name={item.icon} class:list={['size-4', isActive(item.href) ? 'text-amber-300' : 'text-zinc-500']} />
              {item.label}
            </a>
          ))
        }
      </div>
    </nav>
  </template>
</header>

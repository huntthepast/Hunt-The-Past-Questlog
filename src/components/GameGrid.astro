---
import GameCard from './GameCard.astro';
import Icon from './Icon.astro';
import Pagination from './Pagination.astro';
import ListCounter from './ListCounter.astro';
import EmptyState from './EmptyState.astro';
import { platformOf, type Game } from '../lib/data';
import { STATUSES } from '../lib/constants.js';

interface Props {
  games: Game[];
  showStatus?: boolean;
  showFavorite?: boolean;
  emptyTitle?: string;
  emptyText?: string;
}

const { games, showStatus = true, showFavorite = true, emptyTitle = 'Nothing here yet', emptyText = 'Add games from the local admin and publish.' } = Astro.props;

const platforms = [...new Set(games.map((g) => g.data.platform))].map(platformOf).sort((a, b) => a.name.localeCompare(b.name));
const statuses = STATUSES.filter((s) => games.some((g) => g.data.status === s.id));

const PAGE_SIZES = [12, 24, 36, 48];

const filterConfig = {
  facets: ['platform', 'status'],
  flags: ['favorite'],
  defaultSort: 'title',
  pageSize: 24,
  pageSizes: PAGE_SIZES,
  storageKey: 'questlog:library',
  sorts: {
    title: { attr: 'sort' },
    titleDesc: { attr: 'sort', dir: 'desc' },
    recent: { attr: 'updated', dir: 'desc' },
    finished: { attr: 'finished', dir: 'desc' },
    rating: { attr: 'rating', dir: 'desc', numeric: true },
    hours: { attr: 'hours', dir: 'desc', numeric: true },
    year: { attr: 'year', dir: 'desc', numeric: true },
    status: { attr: 'statusorder', numeric: true },
  },
};
---

{
  games.length === 0 ? (
    <EmptyState title={emptyTitle} icon="gamepad">
      {emptyText}
    </EmptyState>
  ) : (
    <div x-data={`listFilter(${JSON.stringify(filterConfig)})`} class="scroll-mt-24">
      <div class="card mb-6 p-3">
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          <label class="relative flex-1 sm:min-w-56">
            <span class="sr-only">Search games</span>
            <Icon name="search" class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-zinc-500" />
            <input type="search" x-model.debounce.150ms="q" placeholder="Search title, platform, genre..." class="input pl-9" />
          </label>

          <select x-model="facet.platform" class="input sm:w-44" aria-label="Platform">
            <option value="">All platforms</option>
            {platforms.map((p) => (
              <option value={p.id}>{p.name}</option>
            ))}
          </select>

          {showStatus && (
            <select x-model="facet.status" class="input sm:w-40" aria-label="Status">
              <option value="">Any status</option>
              {statuses.map((s) => (
                <option value={s.id}>{s.label}</option>
              ))}
            </select>
          )}

          <select x-model="sort" class="input sm:w-40" aria-label="Sort by">
            <option value="title">A-Z</option>
            <option value="titleDesc">Z-A</option>
            <option value="recent">Recently updated</option>
            <option value="finished">Recently finished</option>
            <option value="rating">Rating</option>
            <option value="hours">Hours played</option>
            <option value="year">Release year</option>
            <option value="status">Status</option>
          </select>

          <select x-model.number="pageSize" class="input sm:w-28" aria-label="Games per page">
            {PAGE_SIZES.map((size) => (
              <option value={size}>{size} / page</option>
            ))}
          </select>

          {showFavorite && (
            <button
              type="button"
              role="switch"
              :aria-checked="flag.favorite ? 'true' : 'false'"
              @click="flag.favorite = !flag.favorite"
              class="btn select-none"
              :class="flag.favorite ? 'border-rose-400/60 bg-rose-500/10 text-rose-300 hover:border-rose-300 hover:text-rose-200' : ''"
              title="Show favorites only"
            >
              <Icon name="heart" class="size-4 text-rose-400 transition" :fill="flag.favorite ? 'currentColor' : 'none'" />
              Favorites
            </button>
          )}
        </div>

        <ListCounter total={games.length} pageSize={24} noun="games" />
      </div>

      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6">
        {games.map((game) => (
          <GameCard game={game} />
        ))}
      </div>

      <div x-show="visible === 0" x-cloak class="mt-6">
        <EmptyState title="No games match" icon="filter">
          Try a different search or <button type="button" class="text-amber-400 hover:underline" @click="reset()">reset the filters</button>.
        </EmptyState>
      </div>

      <Pagination />
    </div>
  )
}

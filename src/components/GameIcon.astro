---
/**
 * Square art for a game in a list or sidebar - your own icon, or the RetroAchievements one
 * (see gameIcons in lib/data). Falls back to initials on a tinted square, the same way Cover does,
 * so a row never has a broken or empty image. Covers stay for the places that show art properly:
 * the library grid and the game page.
 */
interface Props {
  src?: string;
  title: string;
  class?: string;
}

const { src, title, class: className = '' } = Astro.props;

const initials = title
  .replace(/^(the|a|an)\s+/i, '')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0]?.toUpperCase() ?? '')
  .join('');

// Same hash as Cover, so a game without either image looks consistent wherever it appears.
let hash = 0;
for (const ch of title) hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;
const hue = hash % 360;
---

{
  src ? (
    <img src={src} alt="" loading="lazy" decoding="async" class:list={['h-full w-full rounded object-cover', className]} />
  ) : (
    <div
      class:list={['flex h-full w-full items-center justify-center rounded', className]}
      style={`background: linear-gradient(160deg, hsl(${hue} 30% 20%), hsl(${(hue + 40) % 360} 35% 11%));`}
      role="img"
      aria-label={title}
    >
      <span class="font-display text-sm leading-none text-white/75">{initials}</span>
    </div>
  )
}

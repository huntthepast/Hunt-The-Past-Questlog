---
import Icon from './Icon.astro';
import { removalRequest, type Source } from '../lib/data';

/**
 * Credits for material on a page that came from somewhere else, plus the one-click way for whoever
 * made it to ask for it to be taken down. Rendered at the end of a guide or tracker; the page's own
 * title and path are baked into the request so it arrives already saying which page it is about.
 */
interface Props {
  sources: Source[];
  title: string;
  path: string;
}

const { sources, title, path } = Astro.props;
// One link inline: whichever route is primary. The credits page lists them all.
const { primary } = removalRequest({ title, path });
---

{
  sources.length > 0 && (
    <aside class="card mt-10 p-4 text-sm" aria-labelledby="sources-heading">
      <p class="eyebrow mb-3 flex items-center gap-1.5" id="sources-heading">
        <Icon name="quote" class="size-3.5 text-amber-400" />
        Sources &amp; credits
      </p>
      <ul class="space-y-2">
        {sources.map((source) => (
          <li class="flex gap-2">
            <span class="mt-2 size-1 shrink-0 rounded-full bg-zinc-700" aria-hidden="true" />
            <span class="min-w-0">
              {source.url ? (
                <a href={source.url} target="_blank" rel="noopener" class="inline-flex items-center gap-1 font-medium text-amber-400 hover:underline">
                  {source.label} <Icon name="external" class="size-3" />
                </a>
              ) : (
                <span class="font-medium text-zinc-100">{source.label}</span>
              )}
              {source.license && <span class="ml-1.5 chip bg-zinc-800 text-zinc-400 ring-zinc-700">{source.license}</span>}
              {source.note && <span class="block text-zinc-400">{source.note}</span>}
            </span>
          </li>
        ))}
      </ul>
      <p class="mt-4 border-t border-zinc-800 pt-3 text-xs leading-relaxed text-zinc-500">
        This material belongs to the people above, not to me, and is credited and linked rather than passed off as
        mine. If any of it is yours and you would rather it was not here,{' '}
        <a href={primary.href} target={primary.external ? '_blank' : undefined} rel={primary.external ? 'noopener' : undefined} class="text-amber-400 hover:underline">
          ask and it comes down
        </a>{' '}
        - no argument, no lawyer needed. See <a href="/credits#removal" class="text-amber-400 hover:underline">removal requests</a>.
      </p>
    </aside>
  )
}

---
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';

interface Props {
  title: string;
  icon?: IconName;
  class?: string;
}

const { title, icon = 'sparkles', class: className = '' } = Astro.props;
---

<div class:list={['card flex flex-col items-center gap-2 px-6 py-12 text-center', className]}>
  <span class="grid size-12 place-items-center rounded-full bg-zinc-800 text-zinc-400">
    <Icon name={icon} class="size-6" />
  </span>
  <p class="font-display text-xl text-zinc-200">{title}</p>
  <div class="max-w-md text-sm text-zinc-500"><slot /></div>
</div>

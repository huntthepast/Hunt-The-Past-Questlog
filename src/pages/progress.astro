---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Badge from '../components/Badge.astro';
import Cover from '../components/Cover.astro';
import Rating from '../components/Rating.astro';
import ProgressBar from '../components/ProgressBar.astro';
import EmptyState from '../components/EmptyState.astro';
import Icon from '../components/Icon.astro';
import { libraryGames, libraryStats, groupByStatus, platformOf, formatDate, formatHours } from '../lib/data';
import { STATUSES } from '../lib/constants.js';
import { bar, text } from '../lib/ui';

const games = await libraryGames();
const stats = libraryStats(games);
const groups = groupByStatus(games);
const counts = STATUSES.map((s) => ({ status: s, count: games.filter((g) => g.data.status === s.id).length }));
---

<Base title="Progress" description="Where every game in the library stands: playing, beaten, completed, mastered or dropped.">
  <SectionHeading level="h1" eyebrow="Status board" title="Progress">
    <p class="mt-2 text-sm text-zinc-400">
      {stats.done} of {stats.owned} library games beaten or better ({stats.donePct}%), {formatHours(stats.hours)} logged in total.
    </p>
  </SectionHeading>

  <!-- Stacked completion bar -->
  <section class="card mb-8 p-4 sm:p-5">
    <div class="mb-3 flex h-3 w-full overflow-hidden rounded-full bg-zinc-800" role="img" aria-label="Library status breakdown">
      {
        counts
          .filter((c) => c.count > 0)
          .map((c) => (
            <div class={bar(c.status.color)} style={`width:${(c.count / Math.max(stats.owned, 1)) * 100}%`} title={`${c.status.label}: ${c.count}`}></div>
          ))
      }
    </div>
    <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
      {
        counts.map((c) => (
          <li class:list={['flex items-center gap-1.5', c.count === 0 && 'opacity-40']}>
            <a href={c.count ? `#${c.status.id}` : undefined} class="flex items-center gap-1.5 hover:text-white">
              <span class:list={['size-2.5 rounded-full', bar(c.status.color)]}></span>
              <span class="text-zinc-300">{c.status.label}</span>
              <span class:list={['font-semibold tabular-nums', text(c.status.color)]}>{c.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    groups.length === 0 ? (
      <EmptyState title="No games in the library" icon="chart">
        Add games in the admin to start tracking progress.
      </EmptyState>
    ) : (
      <div class="grid gap-8">
        {groups.map(({ status, games: list }) => (
          <section id={status.id} class="scroll-mt-24">
            <div class="mb-3 flex items-center gap-3">
              <Badge color={status.color} label={status.label} dot />
              <span class="text-sm text-zinc-500">
                {list.length} {list.length === 1 ? 'game' : 'games'}
              </span>
              <span class="hidden text-xs text-zinc-600 sm:inline">{status.description}</span>
            </div>
            <ul class="card divide-y divide-zinc-800">
              {list.map((game) => {
                const d = game.data;
                const platform = platformOf(d.platform);
                return (
                  <li>
                    <a href={`/games/${game.id}`} class="flex items-center gap-3 p-3 transition hover:bg-zinc-800/50 sm:gap-4">
                      <span class="block h-16 w-12 shrink-0 overflow-hidden rounded bg-zinc-800">
                        <Cover src={d.cover} title={d.title} platformShort={platform.short} />
                      </span>
                      <span class="min-w-0 flex-1">
                        <span class="flex items-center gap-2">
                          <span class="truncate font-medium text-zinc-100">{d.title}</span>
                          {d.favorite && <Icon name="heart" solid class="size-3.5 shrink-0 text-rose-400" title="Favorite" />}
                        </span>
                        <span class="mt-0.5 flex flex-wrap items-center gap-x-3 gap-y-0.5 text-xs text-zinc-500">
                          <span>{platform.short}</span>
                          {d.hoursPlayed !== undefined && (
                            <span class="inline-flex items-center gap-1">
                              <Icon name="clock" class="size-3.5" /> {formatHours(d.hoursPlayed)}
                            </span>
                          )}
                          {d.startedAt && (
                            <span class="inline-flex items-center gap-1">
                              <Icon name="calendar" class="size-3.5" /> {formatDate(d.startedAt)}
                              {d.finishedAt && <span> &rarr; {formatDate(d.finishedAt)}</span>}
                            </span>
                          )}
                        </span>
                        {d.notes && <span class="mt-1 line-clamp-1 text-xs text-zinc-400">{d.notes}</span>}
                      </span>
                      <Rating value={d.rating} class="shrink-0 text-sm" />
                      <Icon name="chevron-right" class="size-4 shrink-0 text-zinc-600" />
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </div>
    )
  }

  {
    stats.owned > 0 && (
      <section class="card mt-10 p-4 sm:p-5">
        <p class="eyebrow mb-2">Completion</p>
        <div class="mb-2 flex items-center justify-between text-sm">
          <span class="text-zinc-300">Beaten, completed or mastered</span>
          <span class="font-semibold tabular-nums text-emerald-300">{stats.donePct}%</span>
        </div>
        <ProgressBar value={stats.donePct} color="emerald" label="Library completion" />
      </section>
    )
  }
</Base>

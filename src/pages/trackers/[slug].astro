---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import Icon from '../../components/Icon.astro';
import Cover from '../../components/Cover.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import GuideHub from '../../components/GuideHub.astro';
import SidebarToolbar from '../../components/SidebarToolbar.astro';
import DrawerHeader from '../../components/DrawerHeader.astro';
import Sources from '../../components/Sources.astro';
import { allTrackers, allGuides, guidesForGame, trackersForGame, trackerProgress, platformOf, formatDate, site } from '../../lib/data';
import { trackerTypeById } from '../../lib/constants.js';
import { trackerSeo, breadcrumbJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const trackers = await allTrackers();
  return trackers.map((tracker) => ({ params: { slug: tracker.id }, props: { tracker } }));
}

const { tracker } = Astro.props;
const d = tracker.data;
const type = trackerTypeById(d.type);
const game = d.game ? await getEntry(d.game) : undefined;
const platform = game ? platformOf(game.data.platform) : undefined;
const relatedGuides = game ? guidesForGame(await allGuides(), game.id) : [];
const relatedTrackers = game ? trackersForGame(await allTrackers(), game.id) : [];
const progress = trackerProgress(tracker);
const trackerOptions = {
  columns: d.checklistColumns,
  collapsed: d.checklistCollapsed,
  sections: d.sections.map((s) => ({ ids: s.items.map((i) => i.id), done: s.items.filter((i) => i.done).length })),
};
const seo = trackerSeo(tracker, game);
const jsonLd = breadcrumbJsonLd(Astro.site, [
  { name: 'Home', path: '/' },
  { name: 'Guides', path: '/guides' },
  ...(game ? [{ name: game.data.title, path: `/games/${game.id}` }] : []),
  { name: d.title, path: `/trackers/${tracker.id}` },
]);
---

<Base title={seo.title} description={seo.description} image={game?.data.cover} jsonLd={jsonLd}>
  <nav class="mb-6 text-sm text-zinc-500" aria-label="Breadcrumb">
    <a href="/guides" class="inline-flex items-center gap-1 hover:text-amber-300"><Icon name="arrow-left" class="size-4" /> Guides &amp; Trackers</a>
  </nav>

  <div x-data={`tracker(${JSON.stringify(tracker.id)}, ${progress.total}, ${JSON.stringify(trackerOptions)})`}>
    <header class="mb-6">
      <div class="mb-3 flex flex-wrap items-center gap-2">
        <Badge color={type.color} label={type.label} />
        {game && <a href={`/games/${game.id}`} class="text-xs text-zinc-400 hover:text-amber-300">{game.data.title}</a>}
      </div>
      <h1 class="text-3xl font-bold leading-tight tracking-tight text-zinc-50 sm:text-4xl">{d.title}</h1>
      {d.summary && <p class="mt-3 max-w-3xl text-lg text-zinc-400">{d.summary}</p>}
    </header>

    <!-- Progress + mode switch -->
    <section class="card mb-8 p-4 sm:p-5">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
        <div class="inline-flex rounded-lg border border-zinc-800 bg-zinc-950/60 p-1 text-sm" role="tablist" aria-label="Whose progress to show">
          <button
            type="button"
            role="tab"
            class="rounded-md px-3 py-1.5 font-medium transition"
            :class="mode === 'owner' ? 'bg-zinc-800 text-amber-300' : 'text-zinc-400 hover:text-zinc-200'"
            :aria-selected="mode === 'owner'"
            @click="setMode('owner')"
          >
            {site.owner}'s progress
          </button>
          <button
            type="button"
            role="tab"
            class="rounded-md px-3 py-1.5 font-medium transition"
            :class="mode === 'mine' ? 'bg-zinc-800 text-amber-300' : 'text-zinc-400 hover:text-zinc-200'"
            :aria-selected="mode === 'mine'"
            @click="setMode('mine')"
          >
            My own progress
          </button>
        </div>
        <div class="text-sm text-zinc-400">
          <span x-show="mode === 'owner'">
            <span class="font-semibold text-zinc-100">{progress.done}</span> / {progress.total} done &middot; <span class="tabular-nums">{progress.pct}%</span>
          </span>
          <span x-show="mode === 'mine'" x-cloak>
            <span class="font-semibold text-zinc-100" x-text="myDone"></span> / {progress.total} done &middot; <span class="tabular-nums" x-text="myPct + '%'"></span>
            <button type="button" class="ml-2 text-xs text-rose-300 hover:underline" @click="confirmReset()">Reset</button>
          </span>
        </div>
      </div>

      <div x-show="mode === 'owner'">
        <ProgressBar value={progress.pct} color={progress.pct === 100 ? 'emerald' : type.color} label="Owner progress" />
      </div>
      <div x-show="mode === 'mine'" x-cloak class="h-2.5 w-full overflow-hidden rounded-full bg-zinc-800" role="progressbar" :aria-valuenow="myPct" aria-valuemin="0" aria-valuemax="100" aria-label="My progress">
        <div class="h-full rounded-full bg-amber-400 transition-[width] duration-300" :style="`width: ${myPct}%`"></div>
      </div>

      <p class="mt-3 text-xs text-zinc-500" x-show="mode === 'mine'" x-cloak>
        <Icon name="info" class="mr-1 inline size-3.5 align-[-2px]" />
        Tick items as you go. Your progress is saved in this browser only and never leaves your device.
      </p>

      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-zinc-800 pt-3 text-xs text-zinc-500" x-cloak>
        <span class="inline-flex items-center gap-2">
          Layout
          <span class="inline-flex overflow-hidden rounded-md border border-zinc-700" role="group" aria-label="Columns">
            {[1, 2, 3].map((n) => (
              <button
                type="button"
                class="px-2 py-0.5 font-mono text-[11px] leading-4 text-zinc-500 transition hover:bg-zinc-800 hover:text-zinc-200 [&+&]:border-l [&+&]:border-zinc-700"
                :class={`cols === ${n} && 'bg-amber-400 text-zinc-950 hover:bg-amber-300 hover:text-zinc-950'`}
                :aria-pressed={`cols === ${n}`}
                @click={`setCols(${n})`}
                title={`${n} column${n > 1 ? 's' : ''}`}
              >
                {'|'.repeat(n)}
              </button>
            ))}
          </span>
        </span>
        {d.sections.length > 1 && (
          <span class="inline-flex items-center gap-2">
            Sections
            <button type="button" class="text-amber-400 hover:underline" @click="setAllCollapsed(true)">Collapse all</button>
            <span class="text-zinc-700">/</span>
            <button type="button" class="text-amber-400 hover:underline" @click="setAllCollapsed(false)">Expand all</button>
          </span>
        )}
      </div>
    </section>

    <div x-data="sidebarDrawer" @keydown.escape.window="closeDrawer()">
    <SidebarToolbar toc={d.sections.length > 1} hub={Boolean(game && relatedGuides.length + relatedTrackers.length > 0)} tocLabel="Sections" />
    <div class="grid gap-10 lg:grid-cols-[1fr_280px]">
      <div class="min-w-0">
        <!-- Sections -->
        <div class="grid gap-6">
          {
            d.sections.map((section, sIndex) => (
              <section class="card scroll-mt-28 overflow-hidden lg:scroll-mt-24" id={`section-${sIndex + 1}`}>
                <div class="flex items-stretch bg-zinc-900/80" :class={`!isCollapsed(${sIndex}) && 'border-b border-zinc-800'`}>
                  <h2 class="min-w-0 flex-1 text-lg font-semibold text-zinc-100">
                    <button
                      type="button"
                      class="flex w-full items-center gap-2 px-4 py-3 text-left transition hover:bg-zinc-800/40"
                      :aria-expanded={`!isCollapsed(${sIndex})`}
                      aria-controls={`section-${sIndex + 1}-items`}
                      @click={`toggleSection(${sIndex})`}
                    >
                      <Icon name="chevron-right" class="size-4 shrink-0 text-zinc-500 transition-transform" :class={`!isCollapsed(${sIndex}) && 'rotate-90'`} />
                      <span class="text-zinc-600">{String(sIndex + 1).padStart(2, '0')}</span>
                      <span class="min-w-0 flex-1 truncate" title={section.title}>{section.title}</span>
                      <span class="shrink-0 font-sans text-xs font-medium tabular-nums text-zinc-400" :class={`sectionTotal(${sIndex}) > 0 && sectionDone(${sIndex}) === sectionTotal(${sIndex}) && 'text-emerald-300'`}>
                        <span x-text={`sectionDone(${sIndex})`}>{section.items.filter((i) => i.done).length}</span> / {section.items.length}
                      </span>
                    </button>
                  </h2>
                  <!-- Whole-section shortcuts for the reader's own progress (the owner's ticks are set in the admin). -->
                  <div class="flex shrink-0 items-center gap-1 pr-3 text-xs" x-show="mode === 'mine'" x-cloak role="group" aria-label={`${section.title}: tick or clear all`}>
                    <button
                      type="button"
                      class="tracker-action"
                      :disabled={`sectionDone(${sIndex}) === sectionTotal(${sIndex})`}
                      @click={`setSection(${sIndex}, true)`}
                      title="Tick every item in this section"
                    >
                      Tick all
                    </button>
                    <button type="button" class="tracker-action" :disabled={`sectionDone(${sIndex}) === 0`} @click={`setSection(${sIndex}, false)`} title="Untick every item in this section">
                      Clear
                    </button>
                  </div>
                </div>
                <ul id={`section-${sIndex + 1}-items`} class="tracker-items divide-y divide-zinc-800/80" :class={`cols > 1 && 'divide-y-0'`} :data-cols="cols" {...(d.checklistCollapsed ? { 'x-cloak': true } : {})} x-show={`!isCollapsed(${sIndex})`}>
                  {section.items.map((item) => (
                    <li>
                      <label
                        class="flex cursor-default items-start gap-3 px-4 py-3 transition"
                        :class="mode === 'mine' ? 'cursor-pointer hover:bg-zinc-800/40' : ''"
                      >
                        <span class="relative mt-0.5 shrink-0">
                          <input
                            type="checkbox"
                            class="peer size-5 rounded border-zinc-600 bg-zinc-950 accent-amber-400 disabled:cursor-default"
                            :checked={`isDone(${JSON.stringify(item.id)}, ${item.done})`}
                            :disabled="mode === 'owner'"
                            checked={item.done}
                            disabled
                            @change={`toggle(${JSON.stringify(item.id)})`}
                            aria-label={item.label}
                          />
                        </span>
                        <span class="min-w-0 flex-1">
                          <span
                            class="block font-medium text-zinc-100 transition"
                            :class={`{ 'text-zinc-500 line-through': isDone(${JSON.stringify(item.id)}, ${item.done}) }`}
                            class:list={[item.done && 'text-zinc-500 line-through']}
                          >
                            {item.label}
                          </span>
                          {item.note && <span class="mt-0.5 block text-sm text-zinc-400">{item.note}</span>}
                        </span>
                        <span x-show={`isDone(${JSON.stringify(item.id)}, ${item.done})`} class="mt-1 shrink-0 text-emerald-400">
                          <Icon name="check-circle" class="size-4" />
                        </span>
                      </label>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>

        <Sources sources={d.sources} title={d.title} path={`/trackers/${tracker.id}`} />

        <p class="mt-8 text-xs text-zinc-500">Updated {formatDate(d.updatedAt)}</p>
      </div>

      <aside class="page-sidebar" x-show="drawer || desktop" x-transition:enter="transition duration-200 ease-out" x-transition:enter-start="max-lg:translate-x-full" x-transition:enter-end="translate-x-0" x-transition:leave="transition duration-150 ease-in" x-transition:leave-start="translate-x-0" x-transition:leave-end="max-lg:translate-x-full" @click="onSidebarClick($event)" aria-label="Tracker navigation">
        <DrawerHeader title="Tracker navigation" />
        {
          game && platform && (
            <a href={`/games/${game.id}`} class="card card-hover flex items-center gap-3 p-3">
              <span class="block h-16 w-12 shrink-0 overflow-hidden rounded bg-zinc-800">
                <Cover src={game.data.cover} title={game.data.title} platformShort={platform.short} />
              </span>
              <span class="min-w-0">
                <span class="eyebrow block text-[10px]">Game</span>
                <span class="block truncate font-medium text-zinc-100">{game.data.title}</span>
                <span class="mt-1 block">
                  <StatusBadge status={game.data.status} short />
                </span>
              </span>
            </a>
          )
        }
        {
          d.sections.length > 1 && (
            <nav class="card p-4" aria-label="Sections" x-data="tocSpy" data-drawer-section="toc">
              <p class="eyebrow mb-2">Sections</p>
              <ol class="space-y-1 text-sm">
                {d.sections.map((section, sIndex) => (
                  <li>
                    <a href={`#section-${sIndex + 1}`} data-slug={`section-${sIndex + 1}`} class="flex items-baseline gap-2 rounded px-1 text-zinc-400 transition hover:text-amber-300">
                      <span class="shrink-0 font-mono text-[11px] text-zinc-600">{String(sIndex + 1).padStart(2, '0')}</span>
                      <span class="truncate">{section.title}</span>
                      <span class="ml-auto shrink-0 text-[11px] text-zinc-600">{section.items.filter((i) => i.done).length}/{section.items.length}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        <div data-drawer-section="hub">{game && <GuideHub game={game} guides={relatedGuides} trackers={relatedTrackers} currentId={tracker.id} />}</div>
      </aside>
    </div>
    </div>
  </div>
</Base>

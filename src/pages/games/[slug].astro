---
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Badge from '../../components/Badge.astro';
import Rating from '../../components/Rating.astro';
import Icon from '../../components/Icon.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import GuideHub from '../../components/GuideHub.astro';
import RaSetTabs from '../../components/RaSetTabs.astro';
import {
  allGames,
  allGuides,
  allTrackers,
  guidesForGame,
  trackersForGame,
  platformOf,
  raGameById,
  raSubsetsOf,
  raSubsetLabel,
  achievementSetsFor,
  type RaGame,
  type AchievementSet,
  formatDate,
  formatDateTime,
  formatHours,
  formatPlaytime,
  renderMarkdown,
} from '../../lib/data';
import { statusById, RA_SITE, steamStoreUrl } from '../../lib/constants.js';
import { gameSeo, gameJsonLd, breadcrumbJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const games = await allGames();
  return games.map((game) => ({ params: { slug: game.id }, props: { game } }));
}

const { game } = Astro.props;
const d = game.data;
const platform = platformOf(d.platform);
const status = statusById(d.status);
const guides = guidesForGame(await allGuides(), game.id);
const trackers = trackersForGame(await allTrackers(), game.id);
const ra = await raGameById(d.raGameId);
// RA subsets (bonus / challenge sets of the same game) are shown as extra tabs, like on retroachievements.org.
const raSubsets = ra ? await raSubsetsOf(ra.data.gameId) : [];
// Steam (synced) and manual sets attached to this game: more tabs, same look.
const extraSets = await achievementSetsFor(game.id);

/** One achievement, whichever source it came from. */
type SetAchievement = {
  id: string | number;
  title: string;
  description: string;
  icon?: string;
  unlockedAt: string | null;
  hardcore: boolean;
  points: number | null;
  type: string | null;
  rarity: number | null;
  hidden: boolean;
  order: number;
};
type Journal = { rating?: number; hoursPlayed?: number; startedAt?: string; finishedAt?: string; review?: string; notes?: string } | undefined;
type GameSet = {
  key: string;
  label: string;
  source: 'ra' | 'ra-subset' | 'steam' | 'manual';
  title: string;
  url: string;
  achievements: SetAchievement[];
  earned: number;
  total: number;
  pct: number;
  points: number;
  pointsEarned: number;
  hardcoreCount: number;
  award: { label: string; color: 'amber' | 'violet' | 'emerald'; date: string | null } | null;
  playtimeSeconds: number;
  syncedAt: string | undefined;
  journal: Journal;
  fold: boolean;
};

// Unlocked achievements first, newest unlock at the top; the locked ones follow in the source's own order.
const sortAchievements = (list: SetAchievement[]) =>
  [...list].sort((a, b) => {
    const ua = a.unlockedAt ?? '';
    const ub = b.unlockedAt ?? '';
    if (ua && ub) return ub.localeCompare(ua) || a.order - b.order;
    if (ua || ub) return ua ? -1 : 1;
    return a.order - b.order;
  });
// Long achievement lists start folded: only the first ACHIEVEMENT_PREVIEW are shown until "Show all" is pressed
// (not worth a button when it would only reveal a handful).
const ACHIEVEMENT_PREVIEW = 8;

const AWARD_LABEL: Record<string, string> = {
  mastered: 'Mastered',
  completed: 'Completed',
  'beaten-hardcore': 'Beaten (Hardcore)',
  'beaten-softcore': 'Beaten (Softcore)',
};

const raSet = (entry: RaGame, key: string, label: string, source: 'ra' | 'ra-subset', journal: Journal): GameSet => {
  const achievements = sortAchievements(
    entry.data.achievements.map((a, order) => ({
      id: a.id,
      title: a.title,
      description: a.description,
      icon: a.badge,
      unlockedAt: a.earnedHardcoreAt ?? a.earnedAt,
      hardcore: Boolean(a.earnedHardcoreAt),
      points: a.points,
      type: a.type,
      rarity: null,
      hidden: false,
      order,
    })),
  );
  const earned = achievements.filter((a) => a.unlockedAt);
  const kind = entry.data.highestAwardKind;
  return {
    key,
    label,
    source,
    title: entry.data.title,
    url: `${RA_SITE}/game/${entry.data.gameId}`,
    achievements,
    earned: earned.length,
    total: entry.data.numAchievements,
    pct: entry.data.numAchievements ? Math.round((earned.length / entry.data.numAchievements) * 100) : 0,
    points: achievements.reduce((sum, a) => sum + (a.points ?? 0), 0),
    pointsEarned: earned.reduce((sum, a) => sum + (a.points ?? 0), 0),
    hardcoreCount: entry.data.numAwardedHardcore,
    award: kind ? { label: AWARD_LABEL[kind] ?? kind, color: kind === 'mastered' ? 'amber' : kind === 'completed' ? 'violet' : 'emerald', date: entry.data.highestAwardDate } : null,
    playtimeSeconds: entry.data.playtimeSeconds,
    syncedAt: entry.data.syncedAt,
    journal,
    fold: achievements.length > ACHIEVEMENT_PREVIEW + 4,
  };
};

const otherSet = (entry: AchievementSet): GameSet => {
  const achievements = sortAchievements(
    entry.data.achievements.map((a, order) => ({
      id: a.id,
      title: a.title,
      description: a.description,
      icon: a.unlockedAt ? a.icon : (a.iconLocked ?? a.icon),
      unlockedAt: a.unlockedAt,
      hardcore: false,
      points: null,
      type: null,
      rarity: a.rarity,
      hidden: a.hidden,
      order,
    })),
  );
  const earned = achievements.filter((a) => a.unlockedAt);
  const complete = achievements.length > 0 && earned.length === achievements.length;
  return {
    key: `set-${entry.id}`,
    label: entry.data.title,
    source: entry.data.source,
    title: `${entry.data.title} achievements`,
    url: entry.data.url ?? (entry.data.appId ? steamStoreUrl(entry.data.appId) : ''),
    achievements,
    earned: earned.length,
    total: achievements.length,
    pct: achievements.length ? Math.round((earned.length / achievements.length) * 100) : 0,
    points: 0,
    pointsEarned: 0,
    hardcoreCount: 0,
    award: complete ? { label: 'All unlocked', color: 'amber', date: earned.map((a) => a.unlockedAt as string).sort().at(-1) ?? null } : null,
    playtimeSeconds: (entry.data.playtimeMinutes ?? 0) * 60,
    syncedAt: entry.data.syncedAt,
    journal: entry.data.journal,
    fold: achievements.length > ACHIEVEMENT_PREVIEW + 4,
  };
};

const hasOthers = extraSets.length > 0;
const sets: GameSet[] = [
  ...(ra ? [raSet(ra, 'main', hasOthers ? 'RetroAchievements' : 'Main set', 'ra', undefined)] : []),
  ...raSubsets.map((s) => raSet(s, `set-${s.data.gameId}`, raSubsetLabel(s.data.title), 'ra-subset', d.subsets.find((j) => j.raGameId === s.data.gameId))),
  ...extraSets.map(otherSet),
];
// The first set is the game's primary one: it shows the game's own stats / review / notes (the RA main set when the
// game is on RA, otherwise the first Steam / manual set). Every other set shows its own journal.
if (sets.length && sets[0].key !== 'main') sets[0] = { ...sets[0], key: 'main', journal: undefined };

const tabSets = sets.map((set) => ({ key: set.key, label: set.label, source: set.source, earned: set.earned, total: set.total, pct: set.pct, title: set.key === 'main' ? d.title : set.title }));
// Play stats per set: the game's own fields for the primary set, each other set's journal (the source's tracked
// time fills in when no hours were logged for it).
const statsSets = (sets.length ? sets : [null]).map((set) => {
  if (!set || set.key === 'main') return { key: 'main', subset: false, rating: d.rating, hoursPlayed: d.hoursPlayed, startedAt: d.startedAt, finishedAt: d.finishedAt };
  const tracked = set.playtimeSeconds > 0 ? Math.round((set.playtimeSeconds / 3600) * 10) / 10 : undefined;
  return { key: set.key, subset: true, rating: set.journal?.rating, hoursPlayed: set.journal?.hoursPlayed ?? tracked, startedAt: set.journal?.startedAt, finishedAt: set.journal?.finishedAt };
});

// Review / notes per set, same rule as the stats.
const textSets = (sets.length ? sets : [null]).map((set) => {
  if (!set || set.key === 'main') return { key: 'main', subset: false, label: 'Main set', review: d.review, notes: d.notes };
  return { key: set.key, subset: true, label: set.label, review: set.journal?.review, notes: set.journal?.notes };
});

const SOURCE_LINK: Record<GameSet['source'], string> = { ra: 'View on RetroAchievements', 'ra-subset': 'View on RetroAchievements', steam: 'View on Steam', manual: 'View source' };

const facts = [
  { label: 'Platform', value: platform.name },
  { label: 'Released', value: d.releaseYear ? String(d.releaseYear) : '' },
  { label: 'Developer', value: d.developer ?? '' },
  { label: 'Publisher', value: d.publisher ?? '' },
  { label: 'Genre', value: d.genres.join(', ') },
].filter((f) => f.value);

const seo = gameSeo(game, guides.length, trackers.length);
const jsonLd = [
  gameJsonLd(Astro.site, game),
  breadcrumbJsonLd(Astro.site, [
    { name: 'Home', path: '/' },
    { name: d.ownership === 'wishlist' ? 'Wishlist' : 'Library', path: d.ownership === 'wishlist' ? '/wishlist' : '/games' },
    { name: d.title, path: `/games/${game.id}` },
  ]),
];
---

<Base title={seo.title} description={seo.description} image={d.cover} jsonLd={jsonLd}>
  <nav class="mb-6 text-sm text-zinc-500" aria-label="Breadcrumb">
    <a href={d.ownership === 'wishlist' ? '/wishlist' : '/games'} class="inline-flex items-center gap-1 hover:text-amber-300">
      <Icon name="arrow-left" class="size-4" /> {d.ownership === 'wishlist' ? 'Wishlist' : 'Library'}
    </a>
  </nav>

  <div class="grid gap-8 lg:grid-cols-[280px_1fr]">
    <!-- Cover column -->
    <aside class="lg:sticky lg:top-24 lg:self-start">
      <div class="card mx-auto aspect-[3/4] w-full max-w-[280px] overflow-hidden">
        <Cover src={d.cover} title={d.title} platformShort={platform.short} eager />
      </div>
      <dl class="card mt-4 divide-y divide-zinc-800 text-sm">
        {
          facts.map((f) => (
            <div class="flex justify-between gap-4 px-4 py-2.5">
              <dt class="text-zinc-500">{f.label}</dt>
              <dd class="text-right text-zinc-200">{f.value}</dd>
            </div>
          ))
        }
        {
          d.raGameId && (
            <div class="flex justify-between gap-4 px-4 py-2.5">
              <dt class="text-zinc-500">RetroAchievements</dt>
              <dd>
                <a href={`${RA_SITE}/game/${d.raGameId}`} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-amber-400 hover:underline">
                  Game #{d.raGameId} <Icon name="external" class="size-3.5" />
                </a>
              </dd>
            </div>
          )
        }
      </dl>
    </aside>

    <!-- Details column (raSets: which achievement set / stats row is shown) -->
    <div class="min-w-0" x-data="raSets">
      <div class="mb-2 flex flex-wrap items-center gap-2">
        <StatusBadge status={d.status} />
        {d.ownership === 'wishlist' && <Badge color="teal" label="Wishlist" />}
        {
          d.favorite && (
            <span class="chip bg-rose-500/15 text-rose-300 ring-rose-500/30">
              <Icon name="heart" solid class="size-3" /> Favorite
            </span>
          )
        }
      </div>
      <h1 class="text-3xl font-bold leading-tight tracking-tight text-zinc-50 sm:text-4xl">{d.title}</h1>
      <p class="mt-2 text-zinc-400">
        {platform.name}{d.releaseYear && <span> &middot; {d.releaseYear}</span>}
      </p>

      <!-- Set switcher (main set + RA subsets): drives the play stats below and the achievement list further down -->
      {sets.length > 1 && <RaSetTabs sets={tabSets} class="mt-5" />}

      <!-- Play stats: one row per set, the visible one follows the selected tab -->
      {
        statsSets.map((stats) => (
          <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4" x-show={`set === ${JSON.stringify(stats.key)}`} {...(stats.subset ? { 'x-cloak': true } : {})}>
            <div class="card p-3">
              <div class="text-xs uppercase tracking-wider text-zinc-500">Rating</div>
              <div class="mt-1 text-xl">{stats.rating !== undefined ? <Rating value={stats.rating} showMax /> : <span class="text-zinc-600">&mdash;</span>}</div>
            </div>
            <div class="card p-3">
              <div class="text-xs uppercase tracking-wider text-zinc-500">Hours</div>
              <div class="mt-1 text-xl font-semibold tabular-nums text-zinc-100">{stats.hoursPlayed !== undefined ? formatHours(stats.hoursPlayed) : <span class="text-zinc-600">&mdash;</span>}</div>
            </div>
            <div class="card p-3">
              <div class="text-xs uppercase tracking-wider text-zinc-500">Started</div>
              <div class="mt-1 text-sm font-medium text-zinc-100">{stats.startedAt ? formatDate(stats.startedAt) : <span class="text-zinc-600">&mdash;</span>}</div>
            </div>
            <div class="card p-3">
              <div class="text-xs uppercase tracking-wider text-zinc-500">Finished</div>
              <div class="mt-1 text-sm font-medium text-zinc-100">{stats.finishedAt ? formatDate(stats.finishedAt) : <span class="text-zinc-600">&mdash;</span>}</div>
            </div>
          </div>
        ))
      }

      {
        d.tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-1.5">
            {d.tags.map((tag) => (
              <li class="chip bg-zinc-800 text-zinc-300 ring-zinc-700">
                <Icon name="tag" class="size-3" /> {tag}
              </li>
            ))}
          </ul>
        )
      }

      <!-- Review + notes: the main set's or, when a subset tab is selected, that subset's -->
      {
        textSets.map((entry) => (
          <div x-show={`set === ${JSON.stringify(entry.key)}`} {...(entry.subset ? { 'x-cloak': true } : {})}>
            {entry.review && (
              <section class="mt-8">
                <h2 class="h-display mb-2 text-2xl">Review{entry.subset && <span class="ml-2 font-sans text-base font-normal text-zinc-500">{entry.label}</span>}</h2>
                <div class="guide-prose" set:html={renderMarkdown(entry.review)} />
              </section>
            )}
            {entry.notes && (
              <section class="mt-8">
                <h2 class="h-display mb-2 text-2xl">Notes{entry.subset && <span class="ml-2 font-sans text-base font-normal text-zinc-500">{entry.label}</span>}</h2>
                <div class="guide-prose card p-4" set:html={renderMarkdown(entry.notes)} />
              </section>
            )}
          </div>
        ))
      }

      <!-- Achievements: RetroAchievements (main set + subsets), Steam and manual sets as tabs -->
      {
        sets.length > 0 && (
          <section class="mt-10 scroll-mt-24" id="achievements">
            <div class="mb-3 flex flex-wrap items-end justify-between gap-2">
              <h2 class="h-display text-2xl">Achievements</h2>
              {sets.map((set) => set.url && (
                <a
                  href={set.url}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-1 text-sm text-amber-400 hover:underline"
                  x-show={`set === ${JSON.stringify(set.key)}`}
                  {...(set.key !== 'main' ? { 'x-cloak': true } : {})}
                >
                  {SOURCE_LINK[set.source]} <Icon name="external" class="size-3.5" />
                </a>
              ))}
            </div>

            {sets.length > 1 && <RaSetTabs sets={tabSets} class="mb-4" />}

            {sets.map((set) => (
              <div x-show={`set === ${JSON.stringify(set.key)}`} {...(set.key !== 'main' ? { 'x-cloak': true } : {})} x-data="showMore" id={set.key !== 'main' ? set.key : undefined} class="scroll-mt-24">
                <div class="card p-4">
                  <div class="mb-2 flex flex-wrap items-center justify-between gap-2 text-sm">
                    <span class="text-zinc-300">
                      <span class="font-semibold text-zinc-100">{set.earned}</span> of {set.total} unlocked
                      {set.source === 'ra' || set.source === 'ra-subset' ? (
                        <span class="text-zinc-500">
                          ({set.hardcoreCount} hardcore) &middot; {set.pointsEarned}/{set.points} points
                        </span>
                      ) : (
                        <span class="text-zinc-500">&middot; {set.pct}%</span>
                      )}
                    </span>
                    {set.award && <Badge color={set.award.color} label={set.award.label} dot title={set.award.date ? `Awarded ${formatDateTime(set.award.date)}` : undefined} />}
                  </div>
                  <ProgressBar value={set.pct} color={set.pct === 100 ? 'amber' : 'emerald'} label={`${set.label} progress`} />
                  <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-zinc-500">
                    {set.source === 'ra-subset' && <span class="text-zinc-400">Subset: {set.title}</span>}
                    {set.source === 'manual' && <span class="text-zinc-400">Tracked by hand</span>}
                    {set.playtimeSeconds > 0 && (
                      <span class="inline-flex items-center gap-1" title={set.source === 'steam' ? 'Playtime tracked by Steam' : 'Time spent in this set while the emulator was connected to RetroAchievements'}>
                        <Icon name="clock" class="size-3.5" /> {formatPlaytime(set.playtimeSeconds)} tracked by {set.source === 'steam' ? 'Steam' : 'RA'}
                      </span>
                    )}
                    {set.syncedAt && <span>Synced {formatDateTime(set.syncedAt)}</span>}
                  </p>
                </div>

                <div class="relative">
                  <ul class="mt-4 grid gap-2 sm:grid-cols-2" id={`achievement-list-${set.key}`}>
                    {set.achievements.map((a, index) => {
                      const earned = Boolean(a.unlockedAt);
                      const folded = set.fold && index >= ACHIEVEMENT_PREVIEW;
                      const secret = a.hidden && !earned;
                      return (
                        <li class:list={['card flex items-start gap-3 p-3', !earned && 'opacity-60 grayscale']} {...(folded ? { 'x-show': 'expanded', 'x-cloak': true } : {})}>
                          {a.icon ? (
                            <img src={a.icon} alt="" width="48" height="48" loading="lazy" class="size-12 shrink-0 rounded bg-zinc-800" />
                          ) : (
                            <span class="grid size-12 shrink-0 place-items-center rounded bg-zinc-800 text-zinc-500">
                              <Icon name={secret ? 'lock' : 'check-badge'} class="size-6" />
                            </span>
                          )}
                          <div class="min-w-0 flex-1">
                            <div class="flex items-start justify-between gap-2">
                              {set.source === 'ra' || set.source === 'ra-subset' ? (
                                <a href={`${RA_SITE}/achievement/${a.id}`} target="_blank" rel="noopener" class="font-medium leading-snug text-zinc-100 hover:text-amber-300">
                                  {a.title}
                                </a>
                              ) : (
                                <span class="font-medium leading-snug text-zinc-100">{secret ? 'Hidden achievement' : a.title}</span>
                              )}
                              {a.points !== null && <span class="shrink-0 text-xs font-semibold text-amber-300 tabular-nums">{a.points}</span>}
                              {a.rarity !== null && <span class="shrink-0 text-xs text-zinc-500 tabular-nums" title="Players who have unlocked this">{a.rarity.toFixed(1)}%</span>}
                            </div>
                            <p class="mt-0.5 text-xs text-zinc-400">{secret ? 'Details are revealed once unlocked.' : a.description}</p>
                            <p class="mt-1 flex flex-wrap items-center gap-2 text-[11px] text-zinc-500">
                              {earned ? (
                                <span class="inline-flex items-center gap-1 text-emerald-300">
                                  <Icon name="check" class="size-3" /> {(a.unlockedAt as string).length === 10 ? formatDate(a.unlockedAt as string) : formatDateTime(a.unlockedAt as string)}
                                </span>
                              ) : (
                                <span class="inline-flex items-center gap-1">
                                  <Icon name="lock" class="size-3" /> Locked
                                </span>
                              )}
                              {a.hardcore && (
                                <span class="inline-flex items-center gap-0.5 text-amber-400">
                                  <Icon name="bolt" solid class="size-3" /> Hardcore
                                </span>
                              )}
                              {a.type === 'missable' && <span class="text-rose-300">Missable</span>}
                              {a.type === 'progression' && <span class="text-sky-300">Progression</span>}
                              {a.type === 'win_condition' && <span class="text-violet-300">Win condition</span>}
                            </p>
                          </div>
                        </li>
                      );
                    })}
                  </ul>
                  {set.fold && <div x-show="!expanded" class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-linear-to-t from-zinc-950 to-transparent" aria-hidden="true" />}
                </div>
                {set.fold && (
                  <div class="mt-3 flex justify-center">
                    <button type="button" class="btn" @click="toggle()" :aria-expanded="expanded" aria-controls={`achievement-list-${set.key}`}>
                      <span class="inline-flex items-center gap-1.5" x-show="!expanded">
                        <Icon name="chevron-right" class="size-4 rotate-90 text-amber-400" /> Show all {set.achievements.length} achievements
                      </span>
                      <span class="inline-flex items-center gap-1.5" x-show="expanded" x-cloak>
                        <Icon name="chevron-right" class="size-4 -rotate-90 text-amber-400" /> Show less
                      </span>
                    </button>
                  </div>
                )}
              </div>
            ))}
          </section>
        )
      }

      <!-- Guides & trackers -->
      {
        (guides.length > 0 || trackers.length > 0) && (
          <section class="mt-10">
            <h2 class="h-display mb-3 text-2xl">Guides & Trackers</h2>
            <div class="card p-4">
              <GuideHub game={game} guides={guides} trackers={trackers} variant="panel" />
            </div>
          </section>
        )
      }

      <p class="mt-10 text-xs text-zinc-600">Added {formatDate(d.addedAt)} &middot; Updated {formatDate(d.updatedAt)}</p>
    </div>
  </div>
</Base>

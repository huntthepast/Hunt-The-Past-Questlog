# Copy this file to `.env` (which is git-ignored) and fill it in.
# These values are only ever read by the LOCAL admin server (admin/server.js).
# The public site never sees them — it only reads the JSON snapshots the admin writes.

# Your RetroAchievements username
RA_USERNAME=

# Your RetroAchievements *web* API key
# (retroachievements.org -> Settings -> "Keys" section -> Web API Key)
RA_API_KEY=

# Steam (optional): a free Web API key from https://steamcommunity.com/dev/apikey and your SteamID64
# (the 17-digit number; https://steamid.io can find it). Your profile's "Game details" must be public.
STEAM_API_KEY=
STEAM_ID=

# Port for the local admin UI (optional, default 3333)
ADMIN_PORT=3333

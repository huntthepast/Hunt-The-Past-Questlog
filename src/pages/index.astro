---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import StatTile from '../components/StatTile.astro';
import SectionHeading from '../components/SectionHeading.astro';
import GameCard from '../components/GameCard.astro';
import GuideCard from '../components/GuideCard.astro';
import TrackerCard from '../components/TrackerCard.astro';
import Cover from '../components/Cover.astro';
import StatusBadge from '../components/StatusBadge.astro';
import EmptyState from '../components/EmptyState.astro';
import {
  site,
  raProfile,
  raSynced,
  allGames,
  allGuides,
  allTrackers,
  libraryStats,
  isDone,
  platformOf,
  formatDate,
  formatDateTime,
  formatNumber,
  renderMarkdown,
} from '../lib/data';
import { RA_SITE, raImage } from '../lib/constants.js';

const games = await allGames();
const guides = await allGuides();
const trackers = await allTrackers();
const stats = libraryStats(games);
const gameById = new Map(games.map((g) => [g.id, g]));

const nowPlaying = games.filter((g) => g.data.ownership === 'owned' && g.data.status === 'playing').slice(0, 6);
const recentlyFinished = games
  .filter((g) => g.data.ownership === 'owned' && isDone(g))
  .sort((a, b) => (b.data.finishedAt ?? b.data.updatedAt).localeCompare(a.data.finishedAt ?? a.data.updatedAt))
  .slice(0, 6);
const recentAchievements = raProfile.recentAchievements.slice(0, 6);
const latestGuides = guides.slice(0, 3);
const latestTrackers = trackers.slice(0, 3);
---

<Base>
  <!-- Hero -->
  <section class="relative mb-10 overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 sm:p-10">
    <div class="pointer-events-none absolute -right-10 -top-10 size-64 rounded-full bg-amber-400/10 blur-3xl"></div>
    <p class="eyebrow mb-3">{site.owner}'s game journal</p>
    <h1 class="h-display text-5xl sm:text-6xl">{site.title}</h1>
    <p class="mt-3 max-w-2xl text-lg text-zinc-400">{site.tagline}</p>
    {site.about && <div class="prose prose-invert prose-zinc mt-4 max-w-2xl text-sm" set:html={renderMarkdown(site.about)} />}
    <div class="mt-6 flex flex-wrap gap-2">
      <a href="/games" class="btn btn-accent"><Icon name="grid" class="size-4" /> Browse the library</a>
      <a href="/progress" class="btn"><Icon name="chart" class="size-4" /> Progress</a>
      <a href="/guides" class="btn"><Icon name="book" class="size-4" /> Guides</a>
    </div>
  </section>

  <!-- Stats -->
  <section class="mb-12 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
    <StatTile label="In library" value={stats.owned} icon="gamepad" href="/games" />
    <StatTile label="Playing" value={stats.playing} icon="fire" color="sky" href="/progress#playing" />
    <StatTile label="Finished" value={stats.done} hint={`${stats.donePct}% of library`} icon="check-circle" color="emerald" href="/progress" />
    <StatTile label="Hours logged" value={formatNumber(Math.round(stats.hours))} icon="clock" color="violet" />
    <StatTile label="Wishlist" value={stats.wishlist} icon="bookmark" color="teal" href="/wishlist" />
    {
      raSynced() ? (
        <StatTile label="RA points" value={formatNumber(raProfile.points)} hint={raProfile.rank ? `Rank #${formatNumber(raProfile.rank)}` : undefined} icon="trophy" color="amber" href="/achievements" />
      ) : (
        <StatTile label="Favorites" value={stats.favorites} icon="heart" color="rose" href="/favorites" />
      )
    }
  </section>

  <!-- Now playing -->
  <section class="mb-12">
    <SectionHeading eyebrow="Right now" title="Now Playing" href="/progress#playing" linkLabel="All progress" />
    {
      nowPlaying.length ? (
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
          {nowPlaying.map((game) => (
            <GameCard game={game} />
          ))}
        </div>
      ) : (
        <EmptyState title="Nothing in progress" icon="gamepad">
          Mark a game as <em>Playing</em> in the admin and it will show up here.
        </EmptyState>
      )
    }
  </section>

  <!-- Recently finished + recent achievements -->
  <div class="mb-12 grid gap-10 lg:grid-cols-2">
    <section>
      <SectionHeading eyebrow="Credits rolled" title="Recently Finished" href="/progress" />
      {
        recentlyFinished.length ? (
          <ul class="card divide-y divide-zinc-800">
            {recentlyFinished.map((game) => {
              const platform = platformOf(game.data.platform);
              return (
                <li>
                  <a href={`/games/${game.id}`} class="flex items-center gap-3 p-3 transition hover:bg-zinc-800/50">
                    <span class="block h-14 w-11 shrink-0 overflow-hidden rounded bg-zinc-800">
                      <Cover src={game.data.cover} title={game.data.title} platformShort={platform.short} />
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="block truncate font-medium text-zinc-100">{game.data.title}</span>
                      <span class="block text-xs text-zinc-500">
                        {platform.short}
                        {game.data.finishedAt && <span> &middot; {formatDate(game.data.finishedAt)}</span>}
                      </span>
                    </span>
                    <StatusBadge status={game.data.status} short />
                  </a>
                </li>
              );
            })}
          </ul>
        ) : (
          <EmptyState title="No finished games yet" icon="check-circle">
            Beat something and set its status to <em>Beaten</em>, <em>Completed</em> or <em>Mastered</em>.
          </EmptyState>
        )
      }
    </section>

    <section>
      <SectionHeading eyebrow="RetroAchievements" title="Recent Unlocks" href="/achievements" />
      {
        raSynced() && recentAchievements.length ? (
          <ul class="card divide-y divide-zinc-800">
            {recentAchievements.map((a) => (
              <li>
                <a href={`${RA_SITE}/achievement/${a.id}`} target="_blank" rel="noopener" class="flex items-center gap-3 p-3 transition hover:bg-zinc-800/50">
                  <img src={raImage(a.badge)} alt="" width="48" height="48" loading="lazy" class="size-12 shrink-0 rounded bg-zinc-800" />
                  <span class="min-w-0 flex-1">
                    <span class="flex items-center gap-1.5 truncate font-medium text-zinc-100">
                      {a.title}
                      {a.hardcore && <Icon name="bolt" solid class="size-3.5 shrink-0 text-amber-400" title="Hardcore" />}
                    </span>
                    <span class="block truncate text-xs text-zinc-500">
                      {a.gameTitle} &middot; {a.consoleName} &middot; {formatDateTime(a.date)}
                    </span>
                  </span>
                  <span class="shrink-0 text-xs font-semibold text-amber-300 tabular-nums">{a.points} pts</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <EmptyState title={raSynced() ? 'No recent unlocks' : 'RetroAchievements not synced'} icon="trophy">
            {raSynced()
              ? 'Nothing earned in the last few weeks. Go play something.'
              : 'Add your RA username and API key to the local admin, hit Sync, and publish.'}
          </EmptyState>
        )
      }
    </section>
  </div>

  <!-- Guides & trackers -->
  {
    (latestGuides.length > 0 || latestTrackers.length > 0) && (
      <section class="mb-6">
        <SectionHeading eyebrow="Written down" title="Latest Guides & Trackers" href="/guides" />
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {latestGuides.map((guide) => (
            <GuideCard guide={guide} game={guide.data.game ? gameById.get(guide.data.game.id) : undefined} />
          ))}
          {latestTrackers.map((tracker) => (
            <TrackerCard tracker={tracker} game={tracker.data.game ? gameById.get(tracker.data.game.id) : undefined} />
          ))}
        </div>
      </section>
    )
  }
</Base>
